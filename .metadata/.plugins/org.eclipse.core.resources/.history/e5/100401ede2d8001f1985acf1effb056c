// Java Program to Demonstrate Char Primitive Data Type

public class DataTypes2 {
    public static void main(String[] args)
    {
        // Creating and initializing a custom character
        char a = 'G';

        // Integer data type is generally used for numeric values
        int i = 89;

        // Use byte and short if memory is a constraint
        byte b = 4;

        // This will give error as number is larger than byte range 
        // byte b1 = 7888888955;

        short s = 56;

        // This will give error as number is larger than short range
        // short s1 = 87878787878;

        // By defalut fractional value is double in java
        double d = 4.355453532;

        // For float use 'f' as suffix standard
        float f = 4.7333434f;

        // Need to hold big range of numbers that we need
        // This data type
        long l = 12121;

        System.out.println("char " + a);
        System.out.println("integer " + i);
        System.out.println("byte " + b);
        System.out.println("short " + s);
        System.out.println("float " + f);
        System.out.println("double " + d);
        System.out.println("long " + l);
    }
}
